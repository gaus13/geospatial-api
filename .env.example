# Application database used when running FastAPI locally.
DATABASE_URL=postgresql+psycopg2://geo_user:geo_password@localhost:5433/geospatial

# Separate database used by the pytest suite.
TEST_DATABASE_URL=postgresql+psycopg2://geo_user:geo_password@localhost:5433/geospatial_test

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=50

# Directory where each uploaded file gets its own UUID-named folder.
UPLOAD_DIR=uploads
